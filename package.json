{
  "name": "ai-product-agent",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @ai-product-agent/api --filter @ai-product-agent/web dev",
    "dev:api": "pnpm --filter @ai-product-agent/api dev",
    "dev:worker": "pnpm --filter @ai-product-agent/worker dev",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "test:integration": "node tests/integration.mjs",
    "dev:web": "pnpm --filter @ai-product-agent/web dev",
    "typecheck": "pnpm --recursive typecheck",
    "test": "node tests/contract.mjs",
    "build": "pnpm --recursive build"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=20" }
}
