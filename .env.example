NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Add provider credentials only in a local, untracked .env file.
OPENAI_API_KEY=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
