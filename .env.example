NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Add provider credentials only in a local, untracked .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=write_products,read_products
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_product_agent
REDIS_URL=redis://localhost:6379
DEV_AUTH_BYPASS=true
RESEARCH_PROVIDER=ebay
# Optional credential-free supplier catalog: printful
OPENFOODFACTS_USER_AGENT=ai-product-agent/0.1 (https://github.com/saas-codepilot/ai-product-agent)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=http://localhost:4000/api/shopify/oauth/callback
SHOPIFY_MODE=unconfigured
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2
SESSION_TTL_MS=86400000
STORAGE_ROOT=.local-storage
STORAGE_ENDPOINT=
STORAGE_BUCKET=
SHOPIFY_ENCRYPTION_KEY=
